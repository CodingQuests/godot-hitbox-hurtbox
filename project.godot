; Engine configuration file.
; Godot Hitbox Hurtbox
; A component-based damage system: HealthComponent, a passive HitboxComponent
; that deals damage, and an active HurtboxComponent that receives it. Plus a
; sword with a quick and a heavy attack, smashable barrels and a spike trap.
; Open this folder in Godot 4.7+ and press F5.

config_version=5

[application]

config/name="Godot Hitbox Hurtbox"
config/description="Health, hitbox and hurtbox components for Godot 4, with a two-attack sword, knockback, hit-stop and i-frames. From codingquests.io"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://Assets/Tiles/tile_0105.png"

[autoload]

; Remembers the player and camera, and owns shake, hit-stop, camera kick and
; zoom punch, so the weapon and the hurtboxes never need a camera reference.
GameManager="*res://scripts/GameManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
