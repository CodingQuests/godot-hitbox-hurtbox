// Simple "hit flash" shader for 2D sprites.
// Blends the sprite's pixels toward `flash_color` by `flash_amount` (0..1),
// while preserving the original alpha so the silhouette stays clean.
shader_type canvas_item;

uniform float flash_amount : hint_range(0.0, 1.0) = 0.0;
uniform vec4 flash_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	COLOR = vec4(mix(tex.rgb, flash_color.rgb, flash_amount), tex.a);
}
